{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BongoCat Cyber Work",
  "version": "0.1.0",
  "identifier": "com.bongocat.cyberwork",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "counter",
        "title": "Cyber Work Counter",
        "url": "index.html?view=counter",
        "visible": false,
        "width": 340,
        "height": 98,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "create": false
      },
      {
        "label": "history",
        "title": "Cyber Work History",
        "url": "index.html?view=history",
        "visible": false,
        "width": 500,
        "height": 580,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
